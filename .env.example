# Neon Postgres — https://console.neon.tech
DATABASE_URL=

# Anthropic — https://console.anthropic.com
ANTHROPIC_API_KEY=

# FMCSA QCMobile WebKey (optional).
# Without it, carrier lookup falls back to the keyless Socrata census source.
# Get one at https://mobile.fmcsa.dot.gov/QCDevsite (needs a Login.gov account, ~5 min).
FMCSA_WEB_KEY=

# Optional: raises Socrata rate limits. Not required.
SOCRATA_APP_TOKEN=
